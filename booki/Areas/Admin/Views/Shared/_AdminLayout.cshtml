<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Booki Yönetim</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/booki.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
</head>
<body>
    <div class="d-flex">
        <nav class="bg-dark text-white p-3" style="width: 220px; min-height: 100vh;">
            <h5 class="mb-4">Booki Yönetim</h5>
            <ul class="nav flex-column">
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        Panel
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                        Kategoriler
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Authors" asp-action="Index">
                        Yazarlar
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Books" asp-action="Index">
                        Kitaplar
                    </a>
                </li>
            </ul>
        </nav>

        <div class="flex-fill">
            <main role="main" class="p-4">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Panel</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            @ViewData["Title"]
                        </li>
                    </ol>
                </nav>

                @RenderBody()
            </main>
        </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>