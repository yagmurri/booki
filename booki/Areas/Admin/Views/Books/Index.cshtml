@model List<Booki.DataAccess.Entities.Book>

@{
    ViewData["Title"] = "Kitap Yönetimi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Kitap Yönetimi</h1>
            <p class="text-muted mb-0">Kitapları burada yöneteceksin.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Yeni Kitap Ekle
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-book" style="font-size: 3rem;"></i>
            <p class="mt-3 mb-0">Henüz kitap eklenmemiş.</p>
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Başlık</th>
                    <th>Yazar</th>
                    <th>Kategori</th>
                    <th>Yayın Yılı</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author?.FullName</td>
                        <td>@book.Category?.Name</td>
                        <td>@book.PublishedYear</td>
                        <td>
                            <a asp-controller="Chapters" asp-action="Index" asp-route-bookId="@book.Id" class="btn btn-sm btn-outline-secondary">
                                Bölümler
                            </a>
                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">
                                Düzenle
                            </a>
                            <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger">
                                Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>