@model Booki.DataAccess.Entities.Book

@{
    ViewData["Title"] = "Kitap Sil";
}

<div class="container py-4">
    <h1>Kitap Sil</h1>

    <div class="alert alert-warning mt-3">
        Bu kitabı silmek istediğine emin misin? Bu işlem geri alınamaz.
    </div>

    <dl class="row">
        <dt class="col-sm-2">Başlık</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Yazar</dt>
        <dd class="col-sm-10">@Model.Author?.FullName</dd>

        <dt class="col-sm-2">Kategori</dt>
        <dd class="col-sm-10">@Model.Category?.Name</dd>

        <dt class="col-sm-2">Yayın Yılı</dt>
        <dd class="col-sm-10">@Model.PublishedYear</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Evet, Sil</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </form>
</div>