@model List<Booki.DataAccess.Entities.BookChapter>

@{
    var book = ViewBag.Book as Booki.DataAccess.Entities.Book;
    ViewData["Title"] = "Bölümler";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Bölümler</h1>
            <p class="text-muted mb-0">@book?.Title kitabının bölümleri.</p>
        </div>

        <div>
            <a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary">Kitaplara dön</a>
            <a asp-action="Create" asp-route-bookId="@book?.Id" class="btn btn-primary">Yeni Bölüm Ekle</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-file-text" style="font-size: 3rem;"></i>
            <p class="mt-3 mb-0">Bu kitap için henüz bölüm eklenmemiş.</p>
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Sıra</th>
                    <th>Başlık</th>
                    <th>Karakter</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var chapter in Model)
                {
                    <tr>
                        <td>@chapter.OrderNumber</td>
                        <td>@chapter.Title</td>
                        <td>@chapter.Content.Length</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@chapter.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@chapter.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>