@model Booki.DataAccess.Entities.BookChapter

@{
    ViewData["Title"] = "Bölüm Sil";
}

<div class="container py-4">
    <h1>Bölüm Sil</h1>

    <div class="alert alert-warning mt-3">
        Bu bölümü silmek istediğine emin misin? Bu işlem geri alınamaz.
    </div>

    <dl class="row">
        <dt class="col-sm-2">Kitap</dt>
        <dd class="col-sm-10">@Model.Book?.Title</dd>

        <dt class="col-sm-2">Sıra</dt>
        <dd class="col-sm-10">@Model.OrderNumber</dd>

        <dt class="col-sm-2">Başlık</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Karakter</dt>
        <dd class="col-sm-10">@Model.Content.Length</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Evet, Sil</button>
        <a asp-action="Index" asp-route-bookId="@Model.BookId" class="btn btn-outline-secondary">Vazgeç</a>
    </form>
</div>