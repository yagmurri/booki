@model List<Booki.DataAccess.Entities.Author>

@{
    ViewData["Title"] = "Yazar Yönetimi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Yazar Yönetimi</h1>
            <p class="text-muted mb-0">Yazarları burada yöneteceksin.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Yeni Yazar Ekle
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-person" style="font-size: 3rem;"></i>
            <p class="mt-3 mb-0">Henüz yazar eklenmemiş.</p>
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>Doğum Yılı</th>
                    <th>Ölüm Yılı</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var author in Model)
                {
                    <tr>
                        <td>@author.FullName</td>
                        <td>@author.BirthYear</td>
                        <td>@author.DeathYear</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-sm btn-outline-primary">
                                Düzenle
                            </a>
                            <a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-sm btn-outline-danger">
                                Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>