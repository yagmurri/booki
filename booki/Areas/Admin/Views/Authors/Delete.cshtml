@model Booki.DataAccess.Entities.Author

@{
    ViewData["Title"] = "Yazar Sil";
}

<div class="container py-4">
    <h1>Yazar Sil</h1>

    <div class="alert alert-warning mt-3">
        Bu yazarı silmek istediğine emin misin? Bu işlem geri alınamaz.
    </div>

    <dl class="row">
        <dt class="col-sm-2">Ad Soyad</dt>
        <dd class="col-sm-10">@Model.FullName</dd>

        <dt class="col-sm-2">Doğum Yılı</dt>
        <dd class="col-sm-10">@Model.BirthYear</dd>

        <dt class="col-sm-2">Ölüm Yılı</dt>
        <dd class="col-sm-10">@Model.DeathYear</dd>

        <dt class="col-sm-2">Biyografi</dt>
        <dd class="col-sm-10">@Model.Biography</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Evet, Sil</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </form>
</div>