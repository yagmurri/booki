@model List<Booki.DataAccess.Entities.Category>

@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Kategori Yönetimi</h1>
            <p class="text-muted mb-0">Kitap kategorilerini burada yöneteceksin.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Yeni Kategori Ekle
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-folder2-open" style="font-size: 3rem;"></i>
            <p class="mt-3 mb-0">Henüz kategori eklenmemiş.</p>
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Açıklama</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>@category.Description</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">
                                Düzenle
                            </a>
                            <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">
                                Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>