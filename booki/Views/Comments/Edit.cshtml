@model Booki.DataAccess.Entities.Comment

@{
    ViewData["Title"] = "Yorumu Düzenle";
}

<div class="py-4">
    <h1>Yorumu Düzenle</h1>
    <p class="text-muted">@Model.Book?.Title</p>

    @if (TempData["CommentError"] != null)
    {
        <div class="alert alert-danger">@TempData["CommentError"]</div>
    }

    <form asp-action="Edit" method="post" class="mt-4">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="mb-3">
            <textarea name="content" class="form-control" rows="5" maxlength="1000">@Model.Content</textarea>
        </div>

        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">Vazgeç</a>
    </form>
</div>