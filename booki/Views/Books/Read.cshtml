@model Booki.DataAccess.Entities.BookChapter

@{
    var book = ViewBag.Book as Booki.DataAccess.Entities.Book;
    var chapters = ViewBag.Chapters as List<Booki.DataAccess.Entities.BookChapter> ?? new List<Booki.DataAccess.Entities.BookChapter>();
    var previousId = ViewBag.PreviousChapterId as int?;
    var nextId = ViewBag.NextChapterId as int?;
    ViewData["Title"] = $"{book?.Title} - {Model.Title}";
}

<div class="py-4">
    <a asp-action="Details" asp-route-id="@book?.Id" class="btn btn-outline-secondary btn-sm mb-4">← Kitap sayfasına dön</a>

    <div class="row g-4">
        <div class="col-md-3">
            <h6 class="text-muted">@book?.Title</h6>
            <p class="small text-muted">@book?.Author?.FullName</p>

            <div class="list-group">
                @foreach (var c in chapters)
                {
                    <a asp-action="Read" asp-route-id="@book?.Id" asp-route-chapter="@c.Id"
                       class="list-group-item list-group-item-action @(c.Id == Model.Id ? "active" : "")">
                        @c.OrderNumber. @c.Title
                    </a>
                }
            </div>
        </div>

        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <h2 class="mb-0">@Model.Title</h2>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    var isBookmarked = ViewBag.IsBookmarked as bool? ?? false;

                    <form asp-controller="Bookmarks" asp-action="Toggle" method="post">
                        <input type="hidden" name="chapterId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm @(isBookmarked ? "btn-info" : "btn-outline-info")">
                            @(isBookmarked ? "Yer iminden çıkar" : "Yer imine ekle")
                        </button>
                    </form>
                }
            </div>

            <div style="white-space: pre-wrap; line-height: 1.8; font-size: 1.1rem; max-width: 750px;">@Model.Content</div>

            <div class="d-flex justify-content-between mt-5">
                @if (previousId != null)
                {
                    <a asp-action="Read" asp-route-id="@book?.Id" asp-route-chapter="@previousId" class="btn btn-outline-primary">← Önceki bölüm</a>
                }
                else
                {
                    <span></span>
                }

                @if (nextId != null)
                {
                    <a asp-action="Read" asp-route-id="@book?.Id" asp-route-chapter="@nextId" class="btn btn-primary">Sonraki bölüm →</a>
                }
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="mt-5">
                    <h5>Alıntı kaydet</h5>

                    @if (TempData["QuoteMessage"] != null)
                    {
                        <div class="alert alert-info py-2">@TempData["QuoteMessage"]</div>
                    }

                    <form asp-controller="Quotes" asp-action="Create" method="post">
                        <input type="hidden" name="chapterId" value="@Model.Id" />
                        <div class="mb-2">
                            <textarea name="text" class="form-control" rows="3" maxlength="1000"
                                      placeholder="Beğendiğin pasajı buraya yapıştır..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline-primary btn-sm">Alıntıyı kaydet</button>
                    </form>
                </div>
            }
            <hr class="mt-5" />
            <p class="small text-muted mb-0">
                @if (!string.IsNullOrWhiteSpace(book?.SourceName))
                {
                    <span>Kaynak: @book.SourceName.</span>
                }
                @if (!string.IsNullOrWhiteSpace(book?.CopyrightStatus))
                {
                    <span>Telif durumu: @book.CopyrightStatus.</span>
                }
                @if (!string.IsNullOrWhiteSpace(book?.TranslationCopyrightStatus))
                {
                    <span>Çeviri telif durumu: @book.TranslationCopyrightStatus.</span>
                }
            </p>
        </div>
    </div>
</div>